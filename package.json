{
  "name": "bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable native integrations for web applications.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/example-app",
    "build": "npm run build --workspace=packages/example-app",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "typescript": "^5.7",
    "vitest": "^3.2",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
